APP_NAME=Enterprise AI Assistant
ENVIRONMENT=development
LOG_LEVEL=INFO

OPENAI_API_KEY=
PINECONE_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-assistant
LANGSMITH_TRACING=true

PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-ai-assistant
